    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "User Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// Parse response body\r",
                                    "const responseJson = pm.response.json();\r",
                                    "\r",
                                    "// Cek apakah login berhasil\r",
                                    "if (responseJson.success && responseJson.data) {\r",
                                    "    const token = responseJson.data.token;\r",
                                    "\r",
                                    "    // Simpan token ke environment variable \"access_token\" (override nilai sebelumnya)\r",
                                    "    pm.environment.set(\"access_token\", token);\r",
                                    "\r",
                                    "    // Simpan token ke collection variable \"access_token\" (override di level collection)\r",
                                    "    pm.collectionVariables.set(\"access_token\", token);\r",
                                    "\r",
                                    "    console.log(\"✅ Access token berhasil disimpan ke environment dan collection!\");\r",
                                    "    console.log(\"Token:\", token);\r",
                                    "} else {\r",
                                    "    console.log(\"❌ Login gagal, token tidak disimpan\");\r",
                                    "}"
                                ],
                                "type": "text/javascript",
                                "packages": {},
                                "requests": {}
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "urlencoded",
                            "urlencoded": [
                                {
                                    "key": "username",
                                    "value": "{{username}}",
                                    "type": "text"
                                },
                                {
                                    "key": "password",
                                    "value": "{{password}}",
                                    "type": "text"
                                },
                                {
                                    "key": "ttl_hours",
                                    "value": "24",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/{{version}}/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "{{version}}",
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Login using standard Odoo User (res.users)."
                    },
                    "response": []
                },
