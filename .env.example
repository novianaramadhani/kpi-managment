# Salin berkas ini menjadi .env lalu sesuaikan kredensialnya (chmod 600 .env di server).

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
APP_PORT=3001

# Koneksi PostgreSQL via jaringan Docker kpi-network (gunakan 127.0.0.1:5433 untuk next dev lokal).
DATABASE_URL=postgresql://postgres:your_strong_password@kpi-postgres:5432/kpi_app
POSTGRES_HOST=kpi-postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=kpi_app
DB_VOLUME_NAME=template_kpi_postgres_data

# Set true hanya saat ingin menjalankan migrasi SQL otomatis ketika container start.
AUTO_MIGRATE=false

# Integrasi autentikasi Odoo ERP.
AUTH_MODE=odoo
ODOO_BASE_URL=https://your-odoo-domain.com
ODOO_API_VERSION=v1
ODOO_ADMIN_USER=your_admin_user
ODOO_ADMIN_PASSWORD=your_admin_password
ODOO_SERVICE_NIK=your_service_nik
ODOO_SERVICE_PASSWORD=your_service_password
DEV_SUPERADMIN_NIK=your_superadmin_nik

# Kunci sesi JWT (wajib minimal 32 karakter acak).
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random_here
JWT_EXPIRES_IN=8h

NODE_TLS_REJECT_UNAUTHORIZED=1
NODE_OPTIONS=--max-old-space-size=1536

# Jadwal dan retensi backup harian pada docker-compose.db.yml.
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=14
