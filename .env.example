# PostgreSQL Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/kpi_app

# Odoo ERP Authentication & API Integration
AUTH_MODE=odoo
ODOO_BASE_URL=https://your-odoo-domain.com
ODOO_API_VERSION=v1
ODOO_ADMIN_USER=your_admin_user
ODOO_ADMIN_PASSWORD=your_admin_password

# SSL / TLS Settings (Must be set to 1 in production to prevent Man-in-the-Middle attacks)
NODE_TLS_REJECT_UNAUTHORIZED=1

# JSON Web Token (JWT) Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=8h

# Service Account & Superadmin Configuration
DEV_SUPERADMIN_NIK=your_superadmin_nik
ODOO_SERVICE_NIK=your_service_nik
ODOO_SERVICE_PASSWORD=your_service_password
