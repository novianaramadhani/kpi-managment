# ==============================================================================
# ENVIRONMENT TEMPLATE (DOKUMENTASI VARIABEL TANPA NILAI RAHASIA)
# Salin berkas ini menjadi .env.production di server produksi
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Database Connection (Docker kpi-network)
DATABASE_URL=postgresql://postgres:your_strong_password@kpi-postgres:5432/kpi_app
POSTGRES_HOST=kpi-postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=kpi_app

# Migrasi Database Otomatis (Default: false demi keselamatan data)
AUTO_MIGRATE=false

# Odoo ERP Authentication & Integration
AUTH_MODE=odoo
ODOO_BASE_URL=https://your-odoo-domain.com
ODOO_API_VERSION=v1
ODOO_ADMIN_USER=your_admin_user
ODOO_ADMIN_PASSWORD=your_admin_password
ODOO_SERVICE_NIK=your_service_nik
ODOO_SERVICE_PASSWORD=your_service_password

# Superadmin NIK (Wajib diisi sesuai NIK superadmin sistem)
DEV_SUPERADMIN_NIK=your_superadmin_nik

# Keamanan JSON Web Token (JWT) - Minimal 32 Karakter Acak
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random_here
JWT_EXPIRES_IN=8h

# SSL / TLS Settings
NODE_TLS_REJECT_UNAUTHORIZED=1
NODE_OPTIONS=--max-old-space-size=1536

# Backup Retention Policy (digunakan pada docker-compose.backup.yml)
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=14
