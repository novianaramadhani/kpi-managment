# ==============================================================================
# DOCKER PRODUCTION ENVIRONMENT TEMPLATE (KPI MANAGEMENT)
# Salin file ini menjadi .env di server/lingkungan Docker
# ==============================================================================

# Image Deployment Tag (Diatur otomatis oleh CI/CD atau manual)
APP_IMAGE_TAG=latest

# === PostgreSQL Database Configuration ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kpi_app

# Koneksi Internal Aplikasi ke Database via Docker Network (service: db)
DATABASE_URL=postgresql://postgres:postgres@db:5432/kpi_app

# === Cloudflare Zero Trust Tunnel ===
# Dapatkan token dari Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...your_cloudflare_tunnel_token_here...

# === Application & Odoo ERP Integration ===
AUTH_MODE=odoo
ODOO_BASE_URL=https://your-odoo-domain.com
ODOO_API_VERSION=v1
ODOO_ADMIN_USER=your_admin_user
ODOO_ADMIN_PASSWORD=your_admin_password
ODOO_SERVICE_NIK=your_service_nik
ODOO_SERVICE_PASSWORD=your_service_password
DEV_SUPERADMIN_NIK=your_superadmin_nik

# === Keamanan & Kriptografi JWT ===
# WAJIB minimal 32 karakter acak (aplikasi menolak start di production jika < 32 karakter)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random_here
JWT_EXPIRES_IN=8h
NODE_TLS_REJECT_UNAUTHORIZED=1

# === Backup Retention Policy ===
SCHEDULE=@daily
BACKUP_KEEP_DAYS=14
