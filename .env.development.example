# ==============================================================================
# ENVIRONMENT TEMPLATE: WINDOWS DEVELOPMENT (DOCKER)
# Salin berkas ini menjadi .env.development untuk menjalankan Full Docker di Windows
# ==============================================================================

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Database Connection via Docker Network (kpi-network)
# Di dalam Docker, aplikasi terhubung ke container kpi-postgres port 5432
DATABASE_URL=postgresql://postgres:postgres@kpi-postgres:5432/kpi_app
POSTGRES_HOST=kpi-postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kpi_app

# Lindungi database dari migrasi otomatis saat booting
AUTO_MIGRATE=false

# Odoo ERP Integration (Development)
AUTH_MODE=odoo
ODOO_BASE_URL=https://your-odoo-dev-or-staging.com
ODOO_API_VERSION=v1
ODOO_ADMIN_USER=admin_dev
ODOO_ADMIN_PASSWORD=admin_dev_pass
ODOO_SERVICE_NIK=service_nik_dev
ODOO_SERVICE_PASSWORD=service_pass_dev
DEV_SUPERADMIN_NIK=1.1025.273

# Keamanan JWT Session (Minimal 32 Karakter)
JWT_SECRET=dev_secret_key_minimum_32_characters_random_testing_only
JWT_EXPIRES_IN=8h

# SSL / TLS Settings & Memory
NODE_TLS_REJECT_UNAUTHORIZED=0
NODE_OPTIONS=--max-old-space-size=1536

# Backup Schedule (Docker Backup Service)
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7

