# ==============================================================================
# TEMPLATE .env.production UNTUK UBUNTU PRODUCTION SERVER
# Salin berkas ini menjadi .env.production (chmod 600 .env.production)
# ==============================================================================

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Database Connection via Docker Network (kpi-network)
# Gunakan hostname kpi-postgres dan password riil database produksi
DATABASE_URL=postgresql://postgres:REPLACE_WITH_REAL_PASSWORD@kpi-postgres:5432/kpi_app
POSTGRES_HOST=kpi-postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_REAL_PASSWORD
POSTGRES_DB=kpi_app

# Lindungi data eksisting dari migrasi otomatis tak terverifikasi
AUTO_MIGRATE=false

# Odoo ERP Production Integration
AUTH_MODE=odoo
ODOO_BASE_URL=https://erp.yourcompany.com
ODOO_API_VERSION=v1
ODOO_ADMIN_USER=your_odoo_admin
ODOO_ADMIN_PASSWORD=your_odoo_password
ODOO_SERVICE_NIK=your_service_nik
ODOO_SERVICE_PASSWORD=your_service_password
DEV_SUPERADMIN_NIK=your_superadmin_nik

# Kriptografi JWT Session (Wajib >= 32 karakter)
JWT_SECRET=REPLACE_WITH_YOUR_MINIMUM_32_CHAR_SECRET_KEY
JWT_EXPIRES_IN=8h

# Keamanan Node TLS & Memory Limit
NODE_TLS_REJECT_UNAUTHORIZED=1
NODE_OPTIONS=--max-old-space-size=1536

