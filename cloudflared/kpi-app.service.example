# ==============================================================================
# SYSTEMD SERVICE UNIT CONTOH: APLIKASI NATIVE LAMA DI UBUNTU SERVER
# Berkas referensi rollback: /etc/systemd/system/kpi-app.service
# ==============================================================================

[Unit]
Description=KPI Management Next.js Native Application (Old Service)
After=network.target docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/template
ExecStart=/usr/bin/node --env-file=.env.local .next_fresh/standalone/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

# Keamanan proses
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

